{
  // Use IntelliSense to learn about possible attributes.
  // Hover to view descriptions of existing attributes.
  // For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Django 8000",
      "type": "debugpy",
      "request": "launch",
      "args": [
        "runserver"
      ],
      "django": true,
      "autoStartBrowser": false,
      "program": "${workspaceFolder}/manage.py"
    },
    {
      "name": "Django Test \"project_b_instance\"",
      "type": "debugpy",
      "request": "launch",
      "args": [
        "test",
        "project_b_instance"
      ],
      "django": true,
      "autoStartBrowser": false,
      "program": "${workspaceFolder}/manage.py"
    },
    {
      "name": "Django Test \"project_b_instance\" With pre deletion",
      "type": "debugpy",
      "request": "launch",
      "args": [
        "test",
        "project_b_instance"
      ],
      "django": true,
      "autoStartBrowser": false,
      "program": "${workspaceFolder}/manage.py",
      "preLaunchTask": "Empty ChromaDB Collections"
    },
    {
      "name": "server 8000 django python",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/manage.py",
      "args": [
        "runserver"
      ],
      "django": true
    },
    {
      "name": "chrome 8000 with npm build",
      "type": "chrome",
      "request": "launch",
      "url": "http://localhost:8000",
      "webRoot": "${workspaceFolder}/frontend/src",
      "sourceMaps": true,
      "preLaunchTask": "npm: build"
    },
    {
      "name": "chrome 8000",
      "type": "chrome",
      "request": "launch",
      "url": "http://localhost:8000",
      "webRoot": "${workspaceFolder}/frontend/src",
      "sourceMaps": true,
    },
    {
      "name": "chrome 3000 with npm start",
      "type": "chrome",
      "request": "launch",
      "url": "http://localhost:3000",
      "webRoot": "${workspaceFolder}/frontend/src",
      "sourceMaps": true,
    },
    {
      "name": "server 3000 react npm start",
      "type": "node",
      "request": "launch",
      "runtimeExecutable": "turbo",
      "runtimeArgs": [
        "run",
        "dev"
      ],
      "cwd": "${workspaceFolder}/frontend",
      "console": "integratedTerminal"
    },
    {
      "name": "[agent] Debugging project aware agent",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/project_analyst_agent.py",
      "args": [
        "no problem at first",
        "./"
      ],
      "console": "integratedTerminal"
    },
    {
      "name": "[agent] Creation project aware agent",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/creation_agent.py",
      "args": [
        "I would like, for the agent 'creation_agent.py' to be able to review the context of the messages and the flow of messages of this chain of thought agent implementation. For example, I would like to generate a report, that would be a json file containing each message, their type. For each agent and sub agent.",
        "./"
      ],
      "console": "integratedTerminal"
    },
  ],
  "compounds": [
    {
      "name": "Debug server and frontend with mpm build",
      "configurations": [
        "server 8000 django python",
        "chrome 8000 with npm build",
      ]
    },
    {
      "name": "Debug server and frontend",
      "configurations": [
        "server 8000 django python",
        "chrome 8000",
      ]
    },
    {
      "name": "Debug frontend",
      "configurations": [
        "server 3000 react npm start",
        "chrome 3000 with npm start",
      ]
    },
  ]
}